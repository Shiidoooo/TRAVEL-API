# Deny access to sensitive files
<Files ".env">
    Require all denied
</Files>

<Files "SECURITY_AUDIT.md">
    Require all denied
</Files>

<Files ".gitignore">
    Require all denied
</Files>

# Deny access to all .md files
<FilesMatch "\.md$">
    Require all denied
</FilesMatch>

# Deny access to SQL dump files
<FilesMatch "\.sql$">
    Require all denied
</FilesMatch>
